          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Column deleted successfully\",\n  \"data\": null\n}"
            }
          ]
        }
      ]
    },
