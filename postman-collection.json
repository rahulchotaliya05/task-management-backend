            {
              "name": "Success",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"success\": true,\n  \"message\": \"Column created successfully\",\n  \"data\": {\n    \"column\": {\n      \"_id\": \"...\",\n      \"title\": \"In Review\",\n      \"board\": \"...\",\n      \"position\": 3\n    }\n  }\n}"
            }
          ]
