              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Column updated successfully\",\n  \"data\": {\n    \"column\": { \"_id\": \"...\", \"title\": \"Updated Column Name\", \"position\": 0 }\n  }\n}"
